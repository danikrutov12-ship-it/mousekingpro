{
  "name": "mouse-king-pro",
  "productName": "Mouse King Pro",
  "version": "2.1.2",
  "description": "Mouse King Pro — ИИ-агент на моделях Venice: чат, код, файлы, картинки и видео",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --linux AppImage --publish never",
    "dist:win": "electron-vite build && electron-builder --win nsis --publish never",
    "release": "electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "node-html-parser": "^9.0.6",
    "openai": "^7.50.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@codemirror/language-data": "^6.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.68.0",
    "mermaid": "^12.3.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "desktopName": "mouse-king-pro.desktop",
  "build": {
    "appId": "pro.mouseking.app",
    "productName": "Mouse King Pro",
    "executableName": "mouse-king-pro",
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": ".",
        "filter": [
          "icon.png",
          "icon-256.png"
        ]
      }
    ],
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Development",
      "artifactName": "Mouse-King-Pro-${version}.AppImage",
      "desktop": {
        "entry": {
          "StartupWMClass": "mouse-king-pro",
          "Name": "Mouse King Pro"
        }
      }
    },
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "danikrutov12-ship-it",
        "repo": "mousekingpro",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Mouse-King-Pro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mouse King Pro",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "author": {
    "name": "danikrutov12-ship-it",
    "url": "https://github.com/danikrutov12-ship-it"
  },
  "homepage": "https://github.com/danikrutov12-ship-it/mousekingpro",
  "repository": {
    "type": "git",
    "url": "https://github.com/danikrutov12-ship-it/mousekingpro.git"
  }
}
